# ==============================================================================
# DIGITAL CRAZY HUB - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# File: backend/.env.example
# Security Notice: Placeholders only. NEVER commit real credentials to version control.
# ==============================================================================

# Application Environment
APP_ENV=production
APP_URL=https://digitalcrazyhub.com
APP_DEBUG=false
ALLOWED_ORIGIN=https://digitalcrazyhub.com

# Database Connection (MySQL / MariaDB via PDO)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dch_leads
DB_USER=dch_user
DB_PASS=CHANGE_ME
DB_CHARSET=utf8mb4

# Transactional Email Settings (PHPMailer via Authenticated SMTP)
MAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=info@digitalcrazyhub.com
SMTP_PASSWORD=CHANGE_ME
SMTP_TIMEOUT=10
MAIL_FROM_ADDRESS=info@digitalcrazyhub.com
MAIL_FROM_NAME="Digital Crazy Hub"
MAIL_ADMIN_ADDRESS=info@digitalcrazyhub.com

# Google reCAPTCHA v3 Integration
RECAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY=CHANGE_ME
RECAPTCHA_SCORE_THRESHOLD=0.5
RECAPTCHA_ALLOWED_HOSTNAMES=digitalcrazyhub.com,www.digitalcrazyhub.com
RECAPTCHA_FAIL_CLOSED=true

# Google Sheets Webhook Lead Synchronization
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=CHANGE_ME
GOOGLE_SHEETS_TIMEOUT=5

# Security & Rate Limiting
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_DECAY_SECONDS=600
# comma-separated proxy IPs; leave empty if not behind a proxy
TRUSTED_PROXIES=

# Company Profile PDF Download Security
PROFILE_DOWNLOAD_TOKEN_EXPIRY=300
# absolute path outside the repo, or leave empty
PROFILE_PDF_PATH=

# Application Logging
LOG_FILE=logs/app.log

