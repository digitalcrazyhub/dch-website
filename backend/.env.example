# ==============================================================================
# Digital Crazy Hub - Backend Environment Configuration Template
# Duplicate this file as .env and replace placeholder values with real credentials.
# NEVER commit the real .env file into Git version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
APP_ENV=production
APP_URL=https://digitalcrazyhub.com
APP_DEBUG=false
ALLOWED_ORIGIN=https://digitalcrazyhub.com

# ------------------------------------------------------------------------------
# 2. MySQL Database Connection (PDO)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dch_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# 3. SMTP Mail Service (PHPMailer)
# ------------------------------------------------------------------------------
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_TIMEOUT=10

MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="Digital Crazy Hub"
MAIL_ADMIN_ADDRESS=admin@digitalcrazyhub.com
MAIL_PLANE_IMAGE_URL=

# ------------------------------------------------------------------------------
# 4. Google reCAPTCHA v3 Spam Protection
# ------------------------------------------------------------------------------
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-v3-secret-key
RECAPTCHA_SCORE_THRESHOLD=0.5
RECAPTCHA_ALLOWED_HOSTNAMES=digitalcrazyhub.com,www.digitalcrazyhub.com

# ------------------------------------------------------------------------------
# 5. Google Sheets Integration (Google Apps Script Webhook)
# ------------------------------------------------------------------------------
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-apps-script-deployment-id/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=your-webhook-hmac-secret-base64
GOOGLE_SHEETS_TIMEOUT=8

# ------------------------------------------------------------------------------
# 6. Abuse Prevention & Security
# ------------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_DECAY_SECONDS=600
TRUSTED_PROXIES=500

# ------------------------------------------------------------------------------
# 7. Secure Company Profile Download Settings
# ------------------------------------------------------------------------------
PROFILE_DOWNLOAD_TOKEN_EXPIRY=300
PROFILE_PDF_PATH=storage/documents/digital-crazy-hub-company-profile.pdf

# ------------------------------------------------------------------------------
# 8. Logging & Diagnostics
# ------------------------------------------------------------------------------
LOG_FILE=logs/app.log
LOG_LEVEL=INFO
