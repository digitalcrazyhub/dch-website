# ==============================================================================
# Digital Crazy Hub - Backend Security & Access Control (.htaccess)
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Protect sensitive file types from being served directly
<FilesMatch "(^\.env|\.sql|\.log|\.ini|\.md|composer\.(json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Protect internal directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(src|database|logs|storage|tests|vendor)(/|$) - [F,L]
</IfModule>
