# ==========================================
# DIGITAL CRAZY HUB - ENVIRONMENT TEMPLATE
# Copy to .env and configure for local environment
# ==========================================

# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/digitalcrazyhub

# Database Configuration (When approved/required)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dch_db
DB_USER=root
DB_PASS=

# Mail / SMTP Configuration (When approved/required)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=info@digitalcrazyhub.com
SMTP_PASS=
SMTP_SECURE=tls
MAIL_FROM_ADDRESS=info@digitalcrazyhub.com
MAIL_FROM_NAME="Digital Crazy Hub"

# Google reCAPTCHA v3 / v2 (When approved/required)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google Sheets Webhook Integration (When approved/required)
GOOGLE_SHEETS_WEBHOOK_URL=
